[Unit]
Description=ghc-api-proxy rolling controller
After=network-online.target
Wants=network-online.target
PartOf=ghc-api-proxy-rolling.target

[Service]
Type=exec
UMask=0077
RuntimeDirectory=ghc-api-proxy/controller
RuntimeDirectoryMode=0700
StateDirectory=ghc-api-proxy/controller
StateDirectoryMode=0700
EnvironmentFile=-/etc/ghc-api-proxy/rolling-controller.env
ExecStart=/opt/ghc-api-proxy/.venv/bin/python -m app rolling-controller --state-root /var/lib/ghc-api-proxy/controller --runtime-root /run/ghc-api-proxy --releases-root /opt/ghc-api-proxy/releases --config /etc/ghc-api-proxy/config.yaml
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=30s
Slice=ghc-api-proxy-rolling.slice
